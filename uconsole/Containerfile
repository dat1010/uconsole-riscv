FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^deb /deb [arch=amd64] /' /etc/apt/sources.list \
    && dpkg --add-architecture riscv64 \
    && printf 'deb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports jammy main universe\ndeb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports jammy-updates main universe\ndeb [arch=riscv64] http://ports.ubuntu.com/ubuntu-ports jammy-security main universe\n' > /etc/apt/sources.list.d/riscv64.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git build-essential pkg-config cmake clang libclang-dev gcc-riscv64-linux-gnu g++-riscv64-linux-gnu libc6-dev-riscv64-cross libssl-dev libssl-dev:riscv64 qemu-user file python3 perl xz-utils \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain 1.95.0 --no-modify-path \
    && rustup target add riscv64gc-unknown-linux-gnu \
    && rustup component add rustfmt clippy rust-src
ENV CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_LINKER=riscv64-linux-gnu-gcc
ENV CC_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-gcc
ENV CXX_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-g++
ENV AR_riscv64gc_unknown_linux_gnu=riscv64-linux-gnu-ar
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_LIBDIR_riscv64gc_unknown_linux_gnu=/usr/lib/riscv64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV CARGO_BUILD_JOBS=2 CARGO_PROFILE_RELEASE_DEBUG=0 CARGO_PROFILE_RELEASE_LTO=false
RUN apt-get update && apt-get install -y --no-install-recommends libcap-dev:riscv64 libcap-dev bubblewrap ripgrep python3-pip \
    && pip3 install uv \
    && cargo install --locked just dotslash cargo-nextest \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/codex-rs
